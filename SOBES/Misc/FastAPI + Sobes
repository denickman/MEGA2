# Лучше
router = APIRouter()

@router.post("/courses/{course_id}/enroll")
async def enroll(course_id: int, payload: EnrollPayload, db):
    course = await db.scalar(
        select(Course).where(Course.id == course_id).with_for_update()  # блокируем строку
    )
    if course is None:
        raise HTTPException(404, "Course not found")
    if course.available_seats <= 0:
        raise HTTPException(409, "No seats available")

    existing = await db.scalar(
        select(Enrollment).where(
            Enrollment.user_id == payload.user_id,
            Enrollment.course_id == course_id,
        )
    )
    if existing:
        raise HTTPException(409, "Already enrolled")

    course.available_seats -= 1
    db.add(Enrollment(user_id=payload.user_id, course_id=course.id))
    await db.commit()

    return {"available_seats": course.available_seats}



with_for_update() блокирует строку курса до конца транзакции — конкурентные запросы встанут в очередь и увидят актуальное число мест, а не устаревшее.







