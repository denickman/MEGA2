@router.post("/orders")
async def create_order(
    payload: OrderPayload,
    db,
    current_user: User = Depends(get_current_user),
):
    course = await db.get_course(payload.course_id)
    if not course:
        raise HTTPException(status_code=404, detail="Course not found")

    discount = 0
    if payload.promocode:
        discount = await db.get_promocode_discount(payload.promocode)
        if discount is None:
            raise HTTPException(status_code=400, detail="Invalid promocode")

    total = max(course.price - discount, 0)

    order = await db.create_order(
        user_id=current_user.id,
        course_id=payload.course_id,
        price=total,
        status="pending",
    )

    try:
        async with httpx.AsyncClient(timeout=10.0) as client:
            response = await client.post(
                url="https://payments.example.com/pay",
                json={"order_id": order.id, "amount": total},
            )
            response.raise_for_status()
            payment = response.json()
    except httpx.HTTPError:
        order.status = "payment_failed"
        await db.commit()
        raise HTTPException(status_code=502, detail="Payment provider error")

    order.payment_id = payment["payment_id"]
    order.status = "awaiting_payment"
    await db.commit()

    try:
        await send_email(current_user.email, text="Ваш заказ создан")
    except Exception:
        logger.exception("Failed to send order confirmation email")

    return {"order_id": order.id, "payment_id": payment["payment_id"]}


